# A .pubignore replaces .gitignore for publishing, so build artifacts, tooling,
# and local secrets are excluded explicitly here to keep the archive small and
# free of machine-local files.

# Tooling / IDE
.idea/
*.iml
.dart_tool/
build/

# Example: build artifacts & generated tooling (source is kept)
example/build/
example/.dart_tool/
example/.gradle/
example/android/.gradle/
example/.flutter-plugins
example/.flutter-plugins-dependencies

# Example: machine-local / secret files
example/android/local.properties
example/android/secrets.properties
example/ios/Pods/
example/ios/.symlinks/

# README demo GIF: loaded from GitHub, not needed in the archive.
doc/demo.gif
